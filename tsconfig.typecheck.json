{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "alwaysStrict": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.mts"
  ]
}
